{
  "type": "object",
  "required": [
    "metadata",
    "content"
  ],
  "properties": {
    "content": {
      "type": "object",
      "required": [
        "title",
        "url",
        "language",
        "contentType",
        "oneSentenceSummary",
        "summaryBody",
        "topics",
        "scores"
      ],
      "properties": {
        "language": {
          "type": "string",
          "description": "Language of the SOURCE page (not the output/summary language). 'ja' only if the source page itself is written in Japanese.",
          "enum": [
            "ja",
            "en",
            "zh",
            "ko",
            "other"
          ]
        },
        "originalTitle": {
          "type": "string",
          "description": "Source page's original title, verbatim. REQUIRED when language is one of {en, zh, ko, other}. MUST be omitted (do not include the key, do not set null) when language='ja'. Never derive from URL slug, related papers, or product names.",
          "nullable": true
        },
        "oneSentenceSummary": {
          "type": "string",
          "description": "One sentence summary in Japanese (10-300 chars)"
        },
        "summaryBody": {
          "type": "string",
          "description": "Full summary body in markdown format (100-1200 chars)"
        },
        "url": {
          "type": "string",
          "description": "Article URL"
        },
        "contentType": {
          "type": "string",
          "description": "Content category",
          "enum": [
            "🚀 Product Launch (製品発表)",
            "🔬 Research & Analysis (研究・分析)",
            "💡 Tutorial & How-to (チュートリアル)",
            "🎯 Opinion & Commentary (意見・論評)",
            "📊 Industry News (業界ニュース)",
            "🛠️ Tools & Resources (ツール・リソース)",
            "🎓 Learning & Education (学習・教育)",
            "🌐 Community & Events (コミュニティ・イベント)"
          ]
        },
        "title": {
          "type": "string",
          "description": "Title to display in the journal (always Japanese: copy verbatim if source is Japanese, translate if source is non-Japanese). 1-200 chars."
        },
        "topics": {
          "type": "array",
          "description": "Topic tags (1-5 tags)",
          "items": {
            "type": "string",
            "description": "Topic tag (1-50 chars)"
          }
        },
        "scores": {
          "type": "object",
          "required": [
            "signal",
            "depth",
            "uniqueness",
            "practical",
            "antiHype",
            "mainJournal",
            "annexPotential",
            "overall"
          ],
          "properties": {
            "mainJournal": {
              "type": "integer",
              "description": "Main journal fit score (0-100)"
            },
            "signal": {
              "type": "integer",
              "description": "Signal-to-noise ratio (0-5)"
            },
            "practical": {
              "type": "integer",
              "description": "Practical applicability (0-5)"
            },
            "overall": {
              "type": "integer",
              "description": "Overall quality score (0-100)"
            },
            "antiHype": {
              "type": "integer",
              "description": "Anti-hype factor (0-5)"
            },
            "uniqueness": {
              "type": "integer",
              "description": "Perspective uniqueness (0-5)"
            },
            "depth": {
              "type": "integer",
              "description": "Content depth (0-5)"
            },
            "annexPotential": {
              "type": "integer",
              "description": "Annex journal potential score (0-100)"
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "version",
        "generatedAt",
        "generatedBy"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version (always '1.0')"
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of generation"
        },
        "generatedBy": {
          "type": "string",
          "description": "Model identifier (e.g., gemini-3-flash-preview)"
        }
      }
    }
  }
}
